# Copia este archivo como .env y rellena tus valores reales.
# NUNCA subas el archivo .env a git (ya está en .gitignore).

# --- Telegram Bot ---
# 1. Abre Telegram → busca @BotFather → /newbot → obtén el TOKEN
# 2. Escribe /start a tu bot para activarlo
# 3. Obtén tu CHAT_ID: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_TOKEN=pon_aqui_tu_token
TELEGRAM_CHAT_ID=pon_aqui_tu_chat_id
